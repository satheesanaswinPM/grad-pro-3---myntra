APIFY_TOKEN=
HF_TOKEN=
GROQ_API_KEY=
GROQ_BASE_URL=
LLM_MODEL=openai/gpt-oss-20b
EXTRACT_LIMIT=
EXTRACT_BACKEND=auto
# Groq only -- get a key at https://console.groq.com/keys (starts with gsk_).
# GROQ_BASE_URL defaults to https://api.groq.com/openai/v1; leave blank unless self-hosting a proxy.
# EXTRACT_BACKEND=local covers the full relevant corpus without LLM rate limits.
# EXTRACT_BACKEND=llm forces the API. auto uses the key if GROQ_API_KEY is set.
