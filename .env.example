APIFY_TOKEN=
HF_TOKEN=
OPENAI_API_KEY=
OPENAI_BASE_URL=
LLM_MODEL=gpt-4o-mini
EXTRACT_LIMIT=
EXTRACT_BACKEND=auto
# Groq keys (gsk_...) work if OPENAI_BASE_URL=https://api.groq.com/openai/v1
# and LLM_MODEL=openai/gpt-oss-20b. The client also infers this from a gsk_ key.
# EXTRACT_BACKEND=local covers the full relevant corpus without LLM rate limits.
# EXTRACT_BACKEND=llm forces the API. auto uses the key if OPENAI_API_KEY is set.
